{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://server-ashy-pi-96.vercel.app/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://server-ashy-pi-96.vercel.app/socket.io/:path*"
    },
    {
      "source": "/((?!api|socket.io).*)",
      "destination": "/index.html"
    }
  ]
}
